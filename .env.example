# =====================================================================
# HR Policy Agent Lab — environment configuration
# =====================================================================

# --- Model auth: pick ONE of the two paths below ---------------------

# PATH A — Gemini API key (AI Studio).
# GEMINI_API_KEY=your_gemini_api_key_here

# PATH B — Vertex AI (use your Google Cloud project + gcloud auth)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=lufeng-demo
GOOGLE_CLOUD_LOCATION=global

GEMINI_MODEL=gemini-3.5-flash

# --- Retrieval brain: okf | rag | hybrid ----------------------------
RETRIEVAL_MODE=okf

# --- Vertex AI Search — only for RETRIEVAL_MODE=rag (Track A) --------
VERTEX_AI_SEARCH_LOCATION=global
VERTEX_AI_DATA_STORE_ID=hr-policies-lab-store
VERTEX_AI_SEARCH_ENGINE_ID=hr-policies-lab-engine

# --- Enterprise Systems MCP Integration -----------------------------
MCP_SERVER_URL=https://mock-saas.aishprabhat.demo.altostrat.com
MCP_SERVER_TOKEN=your_mcp_server_token_here
DEFAULT_EMPLOYEE_ID=EMP-1042
